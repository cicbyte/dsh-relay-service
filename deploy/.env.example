# dsh-relay 远程部署配置（复制为 .env 后填写；.env 不入库）
# 加载方：deploy/deploy.py（python-dotenv）

# ===== SSH 连接 =====
# 服务器 IP / 域名（必填）
SSH_HOST=
SSH_PORT=22
SSH_USER=root
# 认证二选一：密码登录填 SSH_PASSWORD；密钥登录填 SSH_KEY_PATH（支持 ~）
SSH_PASSWORD=
SSH_KEY_PATH=
# 加密私钥的口令（私钥未加密留空）
SSH_KEY_PASSPHRASE=

# ===== 部署位置 =====
# 远端部署目录（bin / config / data 都在这里）
REMOTE_DIR=/opt/dsh-relay
# 部署哪些服务，逗号分隔（relay = WS :8787 + 管理台 :8788）
DEPLOY_SERVICES=relay

# ===== 本地交叉编译（本地打 Linux 包，服务器无需 Rust）=====
# 目标平台三元组：x86_64-unknown-linux-gnu（多数 Ubuntu）| aarch64-unknown-linux-gnu（ARM 云主机）
TARGET_TRIPLE=x86_64-unknown-linux-gnu
# 本地构建期环境变量（空格分隔 KEY=VAL）
BUILD_ENV=

# ===== 服务密钥 =====
# JWT 密钥（留空 = 服务自动生成并持久化 data/jwt.secret；生产建议填自己的）
JWT_SECRET=
# 管理台 admin 初始口令（首启种子；未设置则随机生成并一次性打印在日志）
ADMIN_PASSWORD=
# 覆盖 config/relay.toml（可选）：RELAY_AUTH_MODE / RELAY_HOST / RELAY_PORT /
# RELAY_WS_HOST / RELAY_WS_PORT / RELAY_DATABASE_URL

# ===== 系统服务（systemd）=====
# 单元名前缀，实际单元为 <SERVICE_PREFIX>-relay.service（默认 dsh-relay.service）
SERVICE_PREFIX=dsh
# 服务运行用户（留空 = SSH_USER）
SERVICE_USER=
# sudo 密码（SSH_USER 非 root 且 sudo 需要密码时填；NOPASSWD 或 root 留空）
SUDO_PASSWORD=
# 运行期环境变量（空格分隔 KEY=VAL，写入 systemd unit）
SERVICE_ENV=

# ===== 健康检查（部署/重启后探测，留空跳过）=====
RELAY_HEALTH_URL=http://127.0.0.1:8788/api/health
